{
    "layouts": [
        "tall-left",
        "wide-top",
        "fullscreen",
        "column-left"
    ],
    "mod1": [
        "option",
        "shift"
    ],
    "mod2": [
        "option",
        "shift",
        "control"
    ],
    "floating": [],
    "floating-is-blacklist": true,
    "float-small-windows": true,
    "small-window-size": 500,
    "mouse-follows-focus": false,
    "focus-follows-mouse": false,
    "mouse-warps-windows": false,
    "snap-back-windows": true,
    "enables-layout-hud": true,
    "enables-layout-hud-on-space-change": true,
    "enables-window-count-hud": false,
    "enables-refused-tile-hud": true,
    "focus-border": false,
    "focus-border-style": "glow",
    "focus-border-width": 5,
    "focus-border-color": "accent",
    "focus-border-gradient": ["#9B5DE5", "#F4B942"],
    "focus-border-radius": 12,
    "window-overflow": "minimize",
    "window-overflow-size": "reasonable",
    "window-overflow-reasonable-width": 60,
    "window-overflow-reasonable-height": 70,
    "window-overflow-width": 0,
    "window-overflow-height": 0,
    "window-margin-size": 0,
    "window-resize-step": 5,
    "window-margins": false,
    "window-minimum-height": 0,
    "window-minimum-width": 0,
    "window-max-count": 0,
    "ignore-menu-bar": false,
    "main-arrival-position": "last",
    "screen-padding-top": 0,
    "screen-padding-bottom": 0,
    "screen-padding-left": 0,
    "screen-padding-right": 0,
    "debug-layout-info": false,
    "restore-layouts-on-launch": true
}
